# MAIN SUPABASE - Project 1 (required for both web apps)
# Shared login, profiles, events, registrations and all operational records.
# Use the SAME main-project values in student and admin .env.local files.
# Project URL: Supabase dashboard > Project Settings > Data API.
# Publishable key: Project Settings > API Keys; starts with sb_publishable_.
# These are public browser settings. Never enter a secret/service-role key here.
VITE_MAIN_SUPABASE_URL=
VITE_MAIN_SUPABASE_PUBLISHABLE_KEY=

# Optional authenticated event-read cache endpoint; enable after deploying events-read.
# Redis credentials belong only in the backend. Unset/false reads Supabase directly.
VITE_MAIN_EVENTS_CACHE_ENABLED=false
