# CERTIFICATES SUPABASE - Project 2 (Release 2; leave blank for now)
# Private immutable certificate templates and generated PDFs only.
# Login, student/event records and permanent certificate metadata stay in MAIN.
# Proposed server-only settings: no certificate integration consumes these yet.
# Configure in the protected backend environment when Release 2 is implemented.
# Never copy these into apps/student or apps/admin or prefix them with VITE_.

# Project 2 URL, different from the MAIN project URL.
CERTIFICATES_SUPABASE_URL=
# Project 2 privileged secret key. Server-only; never a browser publishable key.
CERTIFICATES_SUPABASE_SECRET_KEY=
