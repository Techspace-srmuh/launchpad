# MAIN backend / Edge Function settings only. Never copy secrets into either app.
# Supabase supplies SUPABASE_URL and SUPABASE_ANON_KEY to Edge Functions.
# Optional: use the MAIN public publishable key instead of the runtime anon key.
MAIN_SUPABASE_PUBLISHABLE_KEY=

# Optional HTTPS Redis REST endpoint (Upstash-compatible command API).
# This is not a redis:// TCP connection string. Leave BOTH blank to disable cache.
# Provider choice, account provisioning and quotas are not yet selected/verified.
REDIS_REST_URL=
REDIS_REST_TOKEN=
# Disposable event cache TTL; 1-300 seconds, default 30.
REDIS_EVENTS_TTL_SECONDS=30

# Exact browser origins allowed to call events-read, comma separated, no paths.
# Add the two real deployment origins before using the function in production.
EVENTS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
