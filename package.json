{
  "name": "techspace-launchpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev:student": "npm --workspace apps/student run dev",
    "dev:admin": "npm --workspace apps/admin run dev",
    "build:student": "npm --workspace apps/student run build",
    "build:admin": "npm --workspace apps/admin run build",
    "build": "npm run build:student && npm run build:admin",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.tooling.json && tsc --noEmit -p supabase/main/supabase/functions/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:live": "node scripts/test-live-events.mjs",
    "test:materials-export": "node scripts/test-live-materials-export.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "start:student": "npm --workspace apps/student run start",
    "start:admin": "npm --workspace apps/admin run start"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@supabase/supabase-js": "^2.57.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.1.1",
    "@tailwindcss/postcss": "^4.1.12"
  }
}
